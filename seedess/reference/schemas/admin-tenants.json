{
  "$id": "https://schemas.seedess.com/admin-tenants.json",
  "title": "AdminTenants",
  "type": "object",
  "required": [
    "ok",
    "tenants"
  ],
  "properties": {
    "ok": {
      "type": "boolean",
      "const": true
    },
    "tenants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "plan": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "members": {
            "type": "integer"
          },
          "streams": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
